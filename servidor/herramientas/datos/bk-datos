#!/usr/bin/env python3
"""Datos en bruto de Bellakaventuras en UN archivo SQLite (24 oct 2026). Servidor: /usr/local/bin/bk-datos; archivo:
/var/lib/bk-datos/bellakaventuras.sqlite. Lo actualiza bk-datos.timer cada hora (Bunny solo guarda sus registros 3 días; IONOS 30)
y el Mac se lo trae con herramientas/datos/datos.sh. Cada pasada añade SOLO lo nuevo (claves únicas: nunca duplica).

Tablas (una fila = un dato tal cual llegó, sin IP, sin navegador completo ni referer completo; se guarda lo útil ya desglosado):
  eventos           avisos del juego /e/… (registro de IONOS; llegan todos aunque Bunny sirva el resto)
  ionos_peticiones  el resto de peticiones que llegan al servidor (desde_bunny = 1 si las pidió Bunny)
  bunny_peticiones  cada petición servida por Bunny (país, caché HIT/MISS…, bytes); incluye también los avisos /e/
  bunny_horas       estadísticas de Bunny por hora (métrica, valor): GB, peticiones, % caché, errores, tráfico al origen…
  bunny_geo         bytes por ubicación de Bunny y día
  cursores, info    control interno (hasta dónde se ha leído cada fuente) y descripción
Columnas comunes: ts (segundos Unix), fecha (hora de Madrid), dispositivo, so, app, navegador, canal (?o= del enlace o la app),
robot (1 = robot conocido). No se guardan las pruebas propias, la IP de casa ni el propio servidor (columna interno = 0 siempre).

    bk-datos              una pasada (lo que falte de IONOS y de Bunny)
    bk-datos --instantanea RUTA   copia consistente del archivo (para bajarla al Mac mientras se sigue escribiendo)
    bk-datos --resumen    filas por tabla y rango de fechas
"""
import datetime, glob, gzip, hashlib, json, os, re, sqlite3, sys, time, urllib.parse, urllib.request

BD = os.environ.get("BK_BD", "/var/lib/bk-datos/bellakaventuras.sqlite")
LOG = os.environ.get("BK_LOG", "/var/log/caddy/bellaka-acceso.log")
NFT = "/etc/bk/bk.nft"
ROBOTS = ("bot", "crawl", "spider", "slurp", "curl", "wget", "python", "go-http", "httpclient", "scan", "headless",
          "preview", "facebookexternalhit", "whatsapp/", "telegrambot", "discord", "h2load", "slowhttptest", "hetrix", "globalping")

ESQUEMA = """
CREATE TABLE IF NOT EXISTS eventos(id INTEGER PRIMARY KEY, clave INTEGER UNIQUE, ts REAL, fecha TEXT, evento TEXT, p TEXT, t INTEGER,
  params TEXT, estado INTEGER, host TEXT, dispositivo TEXT, so TEXT, app TEXT, navegador TEXT, canal TEXT, interno INTEGER, robot INTEGER);
CREATE TABLE IF NOT EXISTS ionos_peticiones(id INTEGER PRIMARY KEY, clave INTEGER UNIQUE, ts REAL, fecha TEXT, metodo TEXT, host TEXT,
  ruta TEXT, consulta TEXT, estado INTEGER, bytes INTEGER, ms REAL, proto TEXT, desde_bunny INTEGER, dispositivo TEXT, so TEXT,
  app TEXT, navegador TEXT, canal TEXT, interno INTEGER, robot INTEGER);
CREATE TABLE IF NOT EXISTS bunny_peticiones(id INTEGER PRIMARY KEY, clave INTEGER UNIQUE, ts REAL, fecha TEXT, cache TEXT, estado INTEGER,
  bytes INTEGER, pais TEXT, pais_borde TEXT, ruta TEXT, consulta TEXT, dispositivo TEXT, so TEXT, app TEXT, navegador TEXT, canal TEXT,
  interno INTEGER, robot INTEGER);
CREATE TABLE IF NOT EXISTS bunny_horas(fecha_hora TEXT, metrica TEXT, valor REAL, PRIMARY KEY(fecha_hora, metrica));
CREATE TABLE IF NOT EXISTS bunny_geo(fecha TEXT, ubicacion TEXT, bytes REAL, PRIMARY KEY(fecha, ubicacion));
CREATE TABLE IF NOT EXISTS cursores(fuente TEXT PRIMARY KEY, valor TEXT);
CREATE TABLE IF NOT EXISTS info(clave TEXT PRIMARY KEY, valor TEXT);
CREATE INDEX IF NOT EXISTS ev_ts ON eventos(ts); CREATE INDEX IF NOT EXISTS ev_evento ON eventos(evento);
CREATE INDEX IF NOT EXISTS ip_ts ON ionos_peticiones(ts); CREATE INDEX IF NOT EXISTS bp_ts ON bunny_peticiones(ts);
"""


def ua_partes(ua):
    u = ua.lower()
    disp = "iPad" if "ipad" in u else "iPhone" if "iphone" in u else "Android" if "android" in u else "Ordenador"
    mi = re.search(r"iphone os (\d+)|cpu os (\d+)", u); ma = re.search(r"android (\d+)", u)
    if disp in ("iPhone", "iPad"):
        so = "iOS " + (mi.group(1) or mi.group(2)) if mi else "iOS"
    elif disp == "Android":
        so = "Android " + ma.group(1) if ma else "Android"
    else:
        so = "Windows" if "windows" in u else "macOS" if "mac os x" in u else "ChromeOS" if "cros" in u else "Linux" if "linux" in u else "otro"
    app = ("Instagram" if "instagram" in u else "TikTok" if ("musical_ly" in u or "bytedance" in u or "tiktok" in u)
           else "Facebook" if ("fban" in u or "fbav" in u) else "WhatsApp" if "whatsapp" in u else "")
    nav = ("Edge" if "edg/" in u else "Samsung" if "samsungbrowser" in u else "Firefox" if ("firefox" in u or "fxios" in u)
           else "Chrome" if ("crios" in u or ("chrome" in u and "; wv)" not in u)) else "WebView" if "; wv)" in u
           else "Safari" if "safari" in u else "otro")
    if nav == "otro" and app:
        nav = "WebView"   # navegador dentro de la app (Instagram, TikTok…)
    return disp, so, app, nav, int(any(b in u for b in ROBOTS))


def canal(ref, app):
    qs = urllib.parse.parse_qs(urllib.parse.urlparse(ref or "").query)
    o = re.sub(r"[^a-z0-9_-]", "", (qs.get("o") or [""])[0].lower())[:20]
    if o:
        return o
    if "ttclid" in qs or app == "TikTok":
        return "tiktok (sin etiqueta)"
    if "fbclid" in qs or app in ("Instagram", "Facebook"):
        return (app.lower() if app else "instagram/facebook") + " (sin etiqueta)"
    return "whatsapp (sin etiqueta)" if app == "WhatsApp" else ""


def consulta_limpia(ruta, qs):
    """Solo lo que no identifica: los parámetros de los avisos /e/ (esquema cerrado) y la etiqueta ?o= del enlace."""
    q = urllib.parse.parse_qs(qs)
    if ruta.startswith("/e/"):
        return {k: v[0][:40] for k, v in q.items()}
    return {"o": q["o"][0][:20]} if "o" in q else {}


def fecha(ts):
    return datetime.datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M:%S")


def permitidos():
    try:
        t = open(NFT).read().split("set permitidos", 1)[1].split("elements", 1)[1].split("{", 1)[1].split("}", 1)[0]
        return {x.strip() for x in t.split(",") if x.strip()}
    except Exception:
        return {"127.0.0.1"}


def cursor(bd, fuente, valor=None):
    if valor is None:
        r = bd.execute("SELECT valor FROM cursores WHERE fuente=?", (fuente,)).fetchone()
        return json.loads(r[0]) if r else None
    bd.execute("INSERT OR REPLACE INTO cursores VALUES(?,?)", (fuente, json.dumps(valor)))


def bunny_ips():
    try:
        return {l.strip() for l in open("/etc/bk/cdn-ips.txt") if l.strip()}
    except Exception:
        return set()


# --------------------------------------------------------------------------------------------------------- IONOS (registro de Caddy)
def linea_ionos(b, ok, cdn, ev, pe):
    try:
        r = json.loads(b); q = r["request"]
    except Exception:
        return
    h = q.get("headers") or {}
    ua = " ".join(h.get("User-Agent", [])); ref = " ".join(h.get("Referer", []))
    ip = q.get("client_ip") or q.get("remote_ip") or ""
    ruta, _, qs = (q.get("uri") or "").partition("?")
    disp, so, app, nav, robot = ua_partes(ua)
    interno = int("X-Bk-Prueba" in h or ua.startswith("BK-Prueba") or "Headless" in ua or ip in ok)
    if interno:
        return   # pruebas propias, casa y el propio servidor: no son datos de jugadores (anoche fueron ~525.000 peticiones de carga)
    clave = int(hashlib.sha1(f"{r.get('ts')}|{q.get('remote_port')}|{q.get('uri')}|{r.get('size')}".encode()).hexdigest()[:15], 16)
    ts = float(r.get("ts", 0)); cons = consulta_limpia(ruta, qs); can = canal(ref, app)
    if ruta.startswith("/e/"):
        ev.append((clave, ts, fecha(ts), ruta[3:], cons.get("p"), int(cons["t"]) if cons.get("t", "").isdigit() else None,
                   json.dumps(cons, ensure_ascii=False), int(r.get("status", 0)), q.get("host"), disp, so, app, nav, can, interno, robot))
    else:
        pe.append((clave, ts, fecha(ts), q.get("method"), q.get("host"), ruta[:200], json.dumps(cons) if cons else "",
                   int(r.get("status", 0)), int(r.get("size", 0)), round(float(r.get("duration", 0)) * 1000, 1), q.get("proto"),
                   int(q.get("remote_ip") in cdn), disp, so, app, nav, can, interno, robot))


def ionos(bd):
    ok, cdn = permitidos(), bunny_ips(); c = cursor(bd, "ionos") or {"gz": [], "ino": None, "pos": 0}
    ev, pe = [], []
    hechos = set(c["gz"])
    # Archivos ya rotados (.gz) que no se han leído enteros: se leen completos. Lo que ya se leyó del archivo vivo antes de rotar
    # se repite, pero las claves únicas lo descartan (INSERT OR IGNORE): nunca se duplica ni se pierde nada.
    for f in sorted(glob.glob(LOG.replace(".log", "-*.log.gz")), key=os.path.getmtime):
        n = os.path.basename(f)
        if n in hechos:
            continue
        with gzip.open(f, "rb") as fh:
            for b in fh:
                linea_ionos(b, ok, cdn, ev, pe)
        hechos.add(n)
    st = os.stat(LOG); pos = c["pos"] if c["ino"] == st.st_ino and c["pos"] <= st.st_size else 0
    with open(LOG, "rb") as fh:
        fh.seek(pos)
        for b in fh:
            if not b.endswith(b"\n"):
                break
            pos += len(b); linea_ionos(b, ok, cdn, ev, pe)
    antes = bd.total_changes
    bd.executemany("INSERT OR IGNORE INTO eventos(clave,ts,fecha,evento,p,t,params,estado,host,dispositivo,so,app,navegador,canal,interno,robot)"
                   " VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", ev)
    n_ev = bd.total_changes - antes; antes = bd.total_changes
    bd.executemany("INSERT OR IGNORE INTO ionos_peticiones(clave,ts,fecha,metodo,host,ruta,consulta,estado,bytes,ms,proto,desde_bunny,"
                   "dispositivo,so,app,navegador,canal,interno,robot) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", pe)
    cursor(bd, "ionos", {"gz": sorted(hechos), "ino": st.st_ino, "pos": pos})
    return n_ev, bd.total_changes - antes


# --------------------------------------------------------------------------------------------------------------------------- Bunny
def bunny_api(url, k, rango=None):
    hd = {"AccessKey": k, "Accept": "application/json"}
    if rango:
        hd["Range"] = f"bytes={rango}-"
    with urllib.request.urlopen(urllib.request.Request(url, headers=hd), timeout=120) as r:
        return r.status, r.read()


def bunny(bd):
    try:
        k = open("/etc/bk/bunny.key").read().strip(); z = open("/etc/bk/bunny.zona").read().strip()
    except Exception:
        return 0, "sin clave de Bunny"
    pref = {".".join(ip.split(".")[:3]) for ip in permitidos() if ip.count(".") == 3}
    nuevas = 0; hoy = datetime.date.today()
    # Los registros de Bunny van del MÁS NUEVO al más antiguo (lo último, arriba): se leen desde arriba en streaming y se para al
    # llegar a lo que ya se tenía (con 10 min de margen por si dos servidores de Bunny escriben algo desordenado). Así solo se baja lo
    # nuevo; las claves únicas descartan lo que se repita en el margen. Bunny guarda 3 días: se repasan ayer y anteayer por si acaso.
    for dd in (2, 1, 0):
        dia = hoy - datetime.timedelta(days=dd); fuente = f"bunny-log-{dia.isoformat()}"
        if dia < datetime.date(2026, 10, 24):
            continue
        visto = cursor(bd, fuente)
        visto = float(visto) if isinstance(visto, (int, float)) and visto > 1e9 else 0.0   # (los cursores antiguos eran bytes)
        req = urllib.request.Request(f"https://logging.bunnycdn.com/{dia.strftime('%m-%d-%y')}/{z}.log", headers={"AccessKey": k})
        try:
            resp = urllib.request.urlopen(req, timeout=300)
        except urllib.error.HTTPError as e:
            if e.code in (404, 416):
                continue
            raise
        filas, maxts = [], visto
        with resp:
            for raw in resp:
                l = raw.decode("utf-8", "replace").rstrip("\n")
                f = l.split("|")
                if len(f) < 12 or not f[2].isdigit():
                    continue
                ts = int(f[2]) / 1000
                if visto and ts < visto - 600:
                    break
                maxts = max(maxts, ts)
                url = urllib.parse.urlparse(f[7]); disp, so, app, nav, robot = ua_partes(f[9])
                cons = consulta_limpia(url.path, url.query); ipa = f[5]
                interno = int(f[9].startswith("BK-Prueba") or "Headless" in f[9] or ".".join(ipa.split(".")[:3]) in pref)
                if interno:
                    continue
                try:
                    clave = int(f[10][:15], 16)
                except ValueError:
                    clave = int(hashlib.sha1(l.encode()).hexdigest()[:15], 16)
                filas.append((clave, ts, fecha(ts), f[0], int(f[1]) if f[1].isdigit() else None, int(f[3]) if f[3].isdigit() else None,
                              f[11], f[8], url.path[:200], json.dumps(cons, ensure_ascii=False) if cons else "", disp, so, app, nav,
                              canal(f[6], app), interno, robot))
        antes = bd.total_changes
        bd.executemany("INSERT OR IGNORE INTO bunny_peticiones(clave,ts,fecha,cache,estado,bytes,pais,pais_borde,ruta,consulta,dispositivo,"
                       "so,app,navegador,canal,interno,robot) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", filas)
        nuevas += bd.total_changes - antes; cursor(bd, fuente, maxts)
    # estadísticas por hora y por ubicación (se reescriben: Bunny las va completando)
    desde = max(datetime.date(2026, 10, 24), hoy - datetime.timedelta(days=2))
    for dia in (desde + datetime.timedelta(days=i) for i in range((hoy - desde).days + 1)):
        _, cuerpo = bunny_api(f"https://api.bunny.net/statistics?pullZone={z}&dateFrom={dia}&dateTo={dia}&hourly=true", k)
        d = json.loads(cuerpo)
        for met, serie in d.items():
            if met.endswith("Chart") and isinstance(serie, dict) and met != "UserBalanceHistoryChart":
                bd.executemany("INSERT OR REPLACE INTO bunny_horas VALUES(?,?,?)", [(fh, met[:-5], v) for fh, v in serie.items()])
        bd.executemany("INSERT OR REPLACE INTO bunny_geo VALUES(?,?,?)", [(dia.isoformat(), u, v) for u, v in (d.get("GeoTrafficDistribution") or {}).items()])
    return nuevas, ""


def abrir():
    os.makedirs(os.path.dirname(BD), exist_ok=True)
    bd = sqlite3.connect(BD, timeout=60); bd.execute("PRAGMA journal_mode=WAL"); bd.executescript(ESQUEMA)
    bd.execute("INSERT OR REPLACE INTO info VALUES('descripcion', ?)", (__doc__.strip().split("\n\n")[0],))
    bd.execute("INSERT OR REPLACE INTO info VALUES('version_esquema', '2')")
    bd.commit()   # sin esto, la copia (--instantanea) se queda esperando a un cambio sin guardar de la propia conexión
    return bd


def main():
    a = sys.argv[1:]
    bd = abrir()
    if a[:1] == ["--instantanea"]:
        dst = sqlite3.connect(a[1]); bd.backup(dst); dst.close(); return
    if a[:1] == ["--resumen"]:
        for t in ("eventos", "ionos_peticiones", "bunny_peticiones", "bunny_horas", "bunny_geo"):
            col = "fecha_hora" if t == "bunny_horas" else "fecha"
            n, a1, a2 = bd.execute(f"SELECT COUNT(*), MIN({col}), MAX({col}) FROM {t}").fetchone()
            print(f"  {t:<18}{n:>10} filas   {a1} → {a2}")
        print(f"  tamaño {os.path.getsize(BD) / 1e6:.1f} MB · {BD}"); return
    t0 = time.time()
    ne, npet = ionos(bd); bd.commit()
    try:
        nb, aviso = bunny(bd); bd.commit()
    except Exception as x:
        nb, aviso = 0, f"Bunny: {x}"
    bd.execute("INSERT OR REPLACE INTO info VALUES('ultima_actualizacion', ?)", (fecha(time.time()),)); bd.commit()
    print(f"bk-datos: +{ne} eventos · +{npet} peticiones IONOS · +{nb} peticiones Bunny · {time.time() - t0:.0f} s {aviso}".strip())


if __name__ == "__main__":
    main()
